<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/chinese_red">


    <TextView
        android:id="@+id/chapterText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="25dp"
        android:layout_marginTop="30dp"
        android:layout_marginBottom="1dp"
        android:fontFamily="serif"
        android:text="Chapter"
        android:textColor="#FFFFFF"
        app:layout_constraintBottom_toTopOf="@+id/chapterSelectSpinner"
        app:layout_constraintEnd_toStartOf="@+id/displayText"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!--TODO fix display text issue
        TODO fix Spinner Font-->

    <TextView
        android:id="@+id/displayText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="5dp"
        android:layout_marginTop="30dp"
        android:layout_marginEnd="95dp"
        android:layout_marginBottom="2dp"
        android:fontFamily="serif"
        android:text="Display"
        android:textColor="#FFFFFF"
        app:layout_constraintBottom_toTopOf="@+id/chapterSelectSpinner"
        app:layout_constraintEnd_toStartOf="@+id/sortText"
        app:layout_constraintStart_toEndOf="@+id/chapterText"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.0" />

    <TextView
        android:id="@+id/sortText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        android:layout_marginEnd="115dp"
        android:layout_marginBottom="2dp"
        android:fontFamily="serif"
        android:text="Sort By"
        android:textColor="#FFFFFF"
        app:layout_constraintBottom_toTopOf="@+id/sortBySpinner"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/displayText"
        app:layout_constraintTop_toTopOf="parent" />

    <Spinner
        android:id="@+id/chapterSelectSpinner"
        android:layout_width="55dp"
        android:layout_height="30dp"
        android:layout_marginStart="25dp"
        android:layout_marginTop="45dp"
        android:layout_marginBottom="26dp"
        android:background="#FFFFFF"
        app:layout_constraintBottom_toTopOf="@+id/characterExpandable"
        app:layout_constraintEnd_toStartOf="@+id/displaySpinner"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <Spinner
        android:id="@+id/displaySpinner"
        android:layout_width="145dp"
        android:layout_height="30dp"
        android:layout_marginTop="45dp"
        android:layout_marginBottom="24dp"
        android:background="#FFFFFF"
        app:layout_constraintBottom_toTopOf="@+id/characterExpandable"
        app:layout_constraintEnd_toStartOf="@+id/sortBySpinner"
        app:layout_constraintStart_toEndOf="@+id/chapterSelectSpinner"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.0" />

    <Spinner
        android:id="@+id/sortBySpinner"
        android:layout_width="145dp"
        android:layout_height="30dp"
        android:layout_marginTop="45dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="24dp"
        android:background="#FFFFFF"
        app:layout_constraintBottom_toTopOf="@+id/characterExpandable"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/displaySpinner"
        app:layout_constraintTop_toTopOf="parent" />

    <ExpandableListView
        android:id="@+id/characterExpandable"
        android:layout_width="409dp"
        android:layout_height="792dp"
        android:layout_marginStart="2dp"
        android:layout_marginTop="32dp"
        android:layout_marginEnd="2dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="1.0" />

</androidx.constraintlayout.widget.ConstraintLayout>